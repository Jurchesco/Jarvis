# Google Sheets
GOOGLE_SHEET_ID=your_spreadsheet_id_here
# Opcjonalnie — domyślnie szuka google-service-account.json w tym folderze
# GOOGLE_CREDENTIALS_FILE=google-service-account.json

# Garmin Connect — domyślnie .garminconnect/ w tym folderze
# GARMIN_TOKEN_DIR=.garminconnect

# openScale — lokalnie: ścieżka do auto backupu (.zip lub .db)
OPENSCALE_BACKUP=F:\Mój dysk\Jarvis\openScale\openScale.db_auto_backup.zip
# GitHub Actions: ID pliku backupu na Google Drive (udostępnij plik Service Account)
# OPENSCALE_DRIVE_FILE_ID=

# Stravio / Supabase (opcjonalnie)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here

# Domyślna liczba dni (gdy naciskasz Enter w promptcie)
DEFAULT_DAYS=7

# Pełny import (--all): data początkowa zakresu
IMPORT_START_DATE=2026-07-09

# Opóźnienie między zapytaniami Garmin API (sekundy)
REQUEST_DELAY_SEC=0.4
